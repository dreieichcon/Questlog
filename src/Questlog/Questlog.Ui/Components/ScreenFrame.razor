<div class="screen-frame">
	<header class="frame-header">
		<div class="frame-title">
			<Logo Url="@LogoUrl"/>
			<span class="frame-header-text">@Title</span>
		</div>
		<span class="frame-header-text"><Clock/></span>
	</header>
	<main class="frame-content">
		@ChildContent
	</main>
	<footer class="frame-footer">
		<div>@FooterLeft</div>
		<div>@FooterRight</div>
	</footer>
</div>
